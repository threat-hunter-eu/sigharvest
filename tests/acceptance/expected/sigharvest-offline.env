# Expected results for `accept.sh sigharvest --offline` (fixtures/sigma). Sourced by lib/sigharvest.sh.
# fixture-sigma-alpha (DRL-1.1): whoami, whoami+surrogate title (same logic), certutil, certutil under a latin-1 file
#   name (same logic), dns, failed logon (base, name: fixture_failed_logon), brute-force correlation, broken.yml,
#   docs/not-a-rule.yaml
# fixture-sigma-beta (MIT): renamed whoami copy (same logic as alpha), certutil variant (new logic), linux shadow
SIG_UNIQUE_LOGIC=7          # whoami, certutil, certutil-variant, dns, failed-logon, correlation, shadow
SIG_WHOAMI_SOURCES=2        # the whoami logic is carried by both repos
SIG_CERTUTIL_LOGICS=2       # 'certutil' finds the decode logic and the decode-or-urlcache variant
SIG_ALL_COPIES_MIN=9        # every copy: 10 rule files, the surrogate one may be quarantined
SIG_ALL_COPIES_MAX=10
SIG_QUARANTINE_FILE=broken.yml
SIG_WINDOWS_LOGIC=5         # --product windows: whoami, certutil, variant, dns, failed-logon (+ correlation has no logsource)
# --- added in harness v3 (features since the first harness) ---
SIG_FIRST_NEW=7             # `changes` after the first update: every unique logic is new
SIG_CHANGES_LIMIT=2         # `changes --limit 2` shows 2 rows and the cap line "5 more: --limit 7 or --json"
SIG_HIGH_CRIT=4             # --level high,critical (= --level high --level critical = level:high OR level:critical), per logic:
                            #   certutil, certutil variant, correlation (high), shadow (critical)
SIG_PROFILE_CORE=3          # --profile core (test/stable, high/critical, core type), per logic: certutil (stable), correlation,
                            #   shadow; the certutil variant is tagged detection.threat-hunting, so no profile has it
SIG_PROFILE_COREPP=4        # --profile core++ (experimental..stable, medium+): core + whoami (medium; canonical copy is test)
SIG_RELEASE_RULES=7         # release build: 7 rules, all with YAML (DRL-1.1 and MIT are permissive)
SIG_RELEASE_COPYRIGHT_ALPHA="Copyright (c) 2026 Alpha Fixture Author"   # fixtures/sigma/alpha/LICENSE -> NOTICE.md
SIG_RELEASE_COPYRIGHT_BETA="Copyright (c) 2026 Beta Fixture Author"     # fixtures/sigma/beta/LICENSE
SIG_BUMP_CHANGED=1          # make_fixtures.py sigma-bump: the DNS rule keeps its id, new logic -> 1 changed
